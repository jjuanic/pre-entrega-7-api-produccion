# Copiá este archivo a ".env" y completá tus claves. El ".env" real está en .gitignore.

# --- LLM de los agentes: google | openai | anthropic ---
LLM_PROVIDER=google
# LLM_MODEL=gemini-flash-latest
# Opcional: un modelo distinto por rol del grafo (si falta, se usa LLM_MODEL).
# Con el free tier de Gemini (≈20 requests/día POR MODELO) repartir los roles entre
# modelos alcanza para la prueba de 5 peticiones concurrentes (~45 llamadas).
# LLM_MODELO_SUPERVISOR=gemini-3-flash-preview
# LLM_MODELO_INVESTIGADOR=gemini-3.7-flash
# LLM_MODELO_ANALISTA=gemini-3.1-flash-lite
# LLM_MODELO_SINTESIS=gemini-3.5-flash-lite
# Respaldo (en orden) si el modelo de un rol falla, p. ej. por cuota diaria agotada:
# LLM_MODELOS_RESPALDO=gemini-flash-lite-latest,gemini-3.1-flash-lite-preview
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- RAG del Investigador (índice de la Pre-entrega 4) ---
# auto = Pinecone si hay credenciales, si no BM25 local | pinecone | local
RESEARCH_BACKEND=auto
PINECONE_API_KEY=
INDEX_NAME=python-docs-rag
PINECONE_NAMESPACE=python-stdlib-es
EMBEDDING_PROVIDER=google

# --- Redis (estado de jobs, cola y checkpoints de LangGraph) ---
# Tiene que ser Redis 8 o Redis Stack (el checkpointer usa RedisJSON + RediSearch).
# Con docker compose, la API y el worker usan redis://redis:6379/0 (se pisa en el compose).
REDIS_URL=redis://localhost:6379/0
# JOB_TTL_SEGUNDOS=604800
# CHECKPOINT_TTL_MINUTOS=10080

# --- Worker ---
WORKER_CONCURRENCIA=5
# JOB_TIMEOUT_SEGUNDOS=900
# true = los consumidores corren dentro del proceso de la API (modo simple, sin `python -m app.worker`)
WORKER_EMBEBIDO=false
PERMITIR_FALLAS_SIMULADAS=true

# --- Human-in-the-loop: umbrales de "costo muy alto" ---
# HITL_MAX_TOKENS=60000
# HITL_MAX_COSTO_USD=0.05
# PRECIO_INPUT_USD_POR_MTOK=0.30
# PRECIO_OUTPUT_USD_POR_MTOK=2.50

# --- Observabilidad: phoenix | langsmith | none ---
OBSERVABILIDAD=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=orquestador-agentes
# Si usás LangSmith en lugar de Phoenix:
# OBSERVABILIDAD=langsmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=orquestador-agentes
